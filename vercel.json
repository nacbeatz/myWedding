{
  "version": 2,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "server/**,shared/**,drizzle/**"
    }
  },
  "rewrites": [
    { "source": "/api/wedding/(.*)", "destination": "/api" },
    { "source": "/api/health", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
